# Copy to .env.local when you want local overrides.
# Spring Boot does not read .env.local automatically; load it through your shell,
# IDE run configuration, Docker Compose env_file, or a helper script.
#
# 구성: 맨 위는 모든 앱 공통(켜 둔 값), 아래 [모듈] 구역은 그 모듈을 얹었을 때만 의미가 있다 (주석 처리 — 필요한 구역만 푼다).
# 모든 설정 키는 Spring 의 느슨한 바인딩으로 환경변수가 된다: skeleton.redis.key-prefix → SKELETON_REDIS_KEY_PREFIX.
# 키 전체와 기본값은 docs/config/modules/<module>.yml.

# ---- 공통 --------------------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local

SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/app
SPRING_DATASOURCE_USERNAME=app
SPRING_DATASOURCE_PASSWORD=dev
FLYWAY_ENABLED=true

# ---- [auth] ------------------------------------------------------------------------------------------
# prod · staging 에서는 기본 JWT 비밀(아래 값)과 내장 시드 계정(user/password, admin/password)으로 기동하지 않는다.
# JWT_SECRET 은 32바이트 이상의 직접 정한 값이어야 하고, AuthAccountRepository 빈을 앱이 둬야 한다.
JWT_ISSUER=kotlin-skeleton
JWT_SECRET=dev-local-jwt-secret-change-me-32-bytes
DEV_LOGIN_ENABLED=true

BREAK_GLASS_ENABLED=false
BREAK_GLASS_SECRET=
BREAK_GLASS_ALLOWED_ACCOUNT_IDS=

# ---- [config-aws-ssm] --------------------------------------------------------------------------------
# paths 를 정하면 dev · staging · prod 에서(또는 AWS_PROFILE 이 있으면 local 에서도) SSM 을 읽는다
# SKELETON_CONFIG_AWS_SSM_FAIL_FAST=true
# AWS_REGION=ap-northeast-2
# AWS_PROFILE=

# ---- [redis-core] · redis-lock · redis-cache · redis-rate-limit  (compose 프로필: redis) -----------------
# SKELETON_REDIS_HOST=localhost
# SKELETON_REDIS_PORT=6379
# SKELETON_REDIS_USERNAME=
# SKELETON_REDIS_PASSWORD=
# SKELETON_REDIS_DATABASE=0
# SKELETON_REDIS_SSL_ENABLED=false
# SKELETON_REDIS_SSL_DISABLE_PEER_VERIFICATION_LOCAL=true
# SKELETON_REDIS_CONNECT_TIMEOUT=2s
# SKELETON_REDIS_COMMAND_TIMEOUT=2s
# SKELETON_REDIS_KEY_PREFIX=kotlin-skeleton:local
# SKELETON_REDIS_JSON_TRUSTED_PACKAGES=dev.sumin.skeleton,java.time,java.util
# [redis-lock] 기동 때 Redis 를 확인하려면 (운영 권장). 락을 아예 끄려면 SKELETON_REDIS_LOCK_ENABLED=false
# SKELETON_REDIS_LOCK_STARTUP_CHECK_ENABLED=true
# SKELETON_REDIS_LOCK_RETRY_ATTEMPTS=3
# SKELETON_REDIS_LOCK_RETRY_BACKOFF=200ms
# [redis-cache]
# SKELETON_REDIS_CACHE_DEFAULT_TTL=10m
# SKELETON_REDIS_CACHE_FAILURE_POLICY=FAIL_OPEN
# [redis-rate-limit]  (skeleton.web.rate-limit.enabled=true 일 때만 쓰인다)
# SKELETON_REDIS_RATE_LIMIT_FAILURE_POLICY=FAIL_OPEN
# SKELETON_REDIS_RATE_LIMIT_KEY_NAMESPACE=default

# ---- [event-kafka]  (compose 프로필: kafka) -----------------------------------------------------------
# SKELETON_EVENT_KAFKA_ENABLED=true
# SKELETON_EVENT_KAFKA_ENVIRONMENT=local
# SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- [notification-mail]  (compose 프로필: mail — 받은 메일 http://localhost:8025) ----------------------
# SKELETON_NOTIFICATION_MAIL_ENABLED=true
# SKELETON_NOTIFICATION_MAIL_FROM=no-reply@example.com
# SPRING_MAIL_HOST=localhost
# SPRING_MAIL_PORT=1025
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# 진짜 SMTP (docs/real-provider-setup.md §4) — 아래 둘이 없으면 인증 · STARTTLS 없이 보낸다
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# 메일 모양 (docs/modules/account.md): 서비스 이름 · 로고(https) · 색 · 문의 주소 · 바닥글 한 줄 · 텍스트만 보내기
# SKELETON_ACCOUNT_MAIL_BRAND_SERVICE_NAME=Notes
# SKELETON_ACCOUNT_MAIL_BRAND_LOGO_URL=
# SKELETON_ACCOUNT_MAIL_BRAND_ACCENT_COLOR=#2563eb
# SKELETON_ACCOUNT_MAIL_BRAND_SUPPORT_ADDRESS=
# SKELETON_ACCOUNT_MAIL_BRAND_FOOTER=
# SKELETON_ACCOUNT_MAIL_HTML_ENABLED=true

# ---- 소셜 로그인: Google · LINE · X (+ Kakao · Naver) — 진짜 제공자 시험: docs/real-provider-setup.md, 모양 점검: scripts/check-real-providers.sh --------
# 한 규칙: 제공자 하나 = 이름이 `SKELETON_AUTH_SOCIAL_` 로 시작하는 변수 몇 개. 비워 두면 그 제공자는 없다 (scripts/dev-sample.sh 는 빈 값을 환경에서 지운다).
#   google · kakao · naver  [auth-social-google|kakao|naver]  SKELETON_AUTH_SOCIAL_PROVIDERS_<제공자>_{ENABLED,CLIENT_ID,CLIENT_SECRET,REDIRECT_URI}   (ENABLED=true 가 있어야 켜진다)
#   LINE · 그 밖의 OIDC     [auth-social-oidc]                  SKELETON_AUTH_SOCIAL_OIDC_PROVIDERS_<코드>_{CLIENT_ID,CLIENT_SECRET,REDIRECT_URI,SCOPES}   (코드는 한 단어, client id 만 있으면 켜진다)
#   X                       [auth-social-x]                     SKELETON_AUTH_SOCIAL_X_{CLIENT_ID,CLIENT_SECRET,REDIRECT_URI,REQUEST_EMAIL}              (client id 만 있으면 켜진다)
# REDIRECT_URI 는 프런트가 인가 요청에 싣는 값과 제공자 콘솔의 등록 값과 **글자 그대로** 같아야 한다 (로그인: <프런트 주소>/auth/callback · 연결 · 다시 인증: <프런트 주소>/account/link-callback — 콘솔에는 둘 다 등록한다).
# X 는 로컬 콜백에 localhost 를 받지 않는다 — X 를 시험할 때는 프런트를 http://127.0.0.1:5173 으로 열고 REDIRECT_URI 도 127.0.0.1 로 쓴다.
SKELETON_AUTH_SOCIAL_PROVIDERS_GOOGLE_ENABLED=
SKELETON_AUTH_SOCIAL_PROVIDERS_GOOGLE_CLIENT_ID=
SKELETON_AUTH_SOCIAL_PROVIDERS_GOOGLE_CLIENT_SECRET=
SKELETON_AUTH_SOCIAL_PROVIDERS_GOOGLE_REDIRECT_URI=
# LINE: LINE Developers 콘솔 > LINE Login 채널의 Channel ID · Channel secret. 이메일은 콘솔의 권한 승인 뒤 SKELETON_AUTH_SOCIAL_OIDC_PROVIDERS_LINE_SCOPES=openid,profile,email
SKELETON_AUTH_SOCIAL_OIDC_PROVIDERS_LINE_CLIENT_ID=
SKELETON_AUTH_SOCIAL_OIDC_PROVIDERS_LINE_CLIENT_SECRET=
SKELETON_AUTH_SOCIAL_OIDC_PROVIDERS_LINE_REDIRECT_URI=
# X: X 개발자 콘솔 앱의 OAuth 2.0 Client ID · Client Secret (OAuth 1.0a 키가 아니다)
SKELETON_AUTH_SOCIAL_X_CLIENT_ID=
SKELETON_AUTH_SOCIAL_X_CLIENT_SECRET=
SKELETON_AUTH_SOCIAL_X_REDIRECT_URI=
SKELETON_AUTH_SOCIAL_PROVIDERS_KAKAO_ENABLED=
SKELETON_AUTH_SOCIAL_PROVIDERS_KAKAO_CLIENT_ID=
SKELETON_AUTH_SOCIAL_PROVIDERS_KAKAO_CLIENT_SECRET=
SKELETON_AUTH_SOCIAL_PROVIDERS_KAKAO_REDIRECT_URI=
SKELETON_AUTH_SOCIAL_PROVIDERS_NAVER_ENABLED=
SKELETON_AUTH_SOCIAL_PROVIDERS_NAVER_CLIENT_ID=
SKELETON_AUTH_SOCIAL_PROVIDERS_NAVER_CLIENT_SECRET=
SKELETON_AUTH_SOCIAL_PROVIDERS_NAVER_REDIRECT_URI=

# ---- [storage-s3] ------------------------------------------------------------------------------------
# SKELETON_STORAGE_S3_BUCKET=
# SKELETON_STORAGE_S3_REGION=ap-northeast-2
# SKELETON_STORAGE_S3_ENDPOINT_OVERRIDE=
# SKELETON_STORAGE_S3_PATH_STYLE_ACCESS_ENABLED=false
# SKELETON_STORAGE_S3_CREDENTIALS_ACCESS_KEY_ID=
# SKELETON_STORAGE_S3_CREDENTIALS_SECRET_ACCESS_KEY=
# SKELETON_STORAGE_S3_PUBLIC_URL_BASE_URL=

# ---- [crypto] ----------------------------------------------------------------------------------------
# 키 ID 마다 하나 (base64 AES 키). 키가 없으면 암호화 빈이 생기지 않는다
# SKELETON_CRYPTO_PRIMARY_KEY_ID=local
# SKELETON_CRYPTO_KEYS_LOCAL=

# ---- [payment-toss] · payment-stripe -----------------------------------------------------------------
# SKELETON_PAYMENT_TOSS_ENABLED=true
# TOSS_PAYMENTS_SECRET_KEY=
# SKELETON_PAYMENT_STRIPE_ENABLED=true
# STRIPE_SECRET_KEY=

# ---- [captcha-turnstile] -----------------------------------------------------------------------------
# SKELETON_CAPTCHA_TURNSTILE_ENABLED=true
# SKELETON_CAPTCHA_TURNSTILE_SECRET_KEY=

# ---- [notification-slack] ----------------------------------------------------------------------------
# SKELETON_NOTIFICATION_SLACK_ENABLED=true
# SKELETON_NOTIFICATION_SLACK_WEBHOOK_URL=

# ---- [notification-websocket] ------------------------------------------------------------------------
# SKELETON_NOTIFICATION_WEBSOCKET_AUTHENTICATION_ENABLED=true
# SKELETON_NOTIFICATION_WEBSOCKET_ENDPOINT_ALLOWED_ORIGIN_PATTERNS=https://app.example.com

# ---- [job-queue-jdbc] --------------------------------------------------------------------------------
# SKELETON_JOB_QUEUE_WORKER_ENABLED=true
# SKELETON_JOB_QUEUE_POLL_INTERVAL=2s
# SKELETON_JOB_QUEUE_MAX_ATTEMPTS=10

# ---- [scheduler] -------------------------------------------------------------------------------------
# SKELETON_SCHEDULER_ZONE=UTC
# SKELETON_SCHEDULER_POOL_SIZE=2

# ---- [time] ------------------------------------------------------------------------------------------
# SKELETON_TIME_DEFAULT_ZONE=Asia/Seoul
# SKELETON_TIME_DEFAULT_LOCALE=ko-KR

# 네이티브 배포 이미지 (선택) — 기본 `Dockerfile`(JVM)은 그대로 두고, 이 파일은 GraalVM 네이티브 실행 파일을 담는다 (docs/native-image.md).
# 홈서버 배포 계약(docs/deploy.md)은 같다: 0.0.0.0:8080 · 로그는 stdout · 컨테이너 안에서 `wget` 이 돈다 · 환경변수 없이도 이미지는 같다.
#
#   docker build -f Dockerfile.native -t <image>:<tag> .                  # apps/api (스타터)
#   docker build -f Dockerfile.native --build-arg APP=sample -t ... .
#   docker build -f Dockerfile.native --build-arg FFMPEG=1 -t ... .       # 앱 안 ffmpeg 를 쓰는 앱(storage-image-ffmpeg)용: 실행 이미지에 ffmpeg 를 넣는다 (기본 꺼짐 — 이미지가 수백 MB 커진다 - ffmpeg 의존 라이브러리)
#
# 주의: 모듈 켜기/끄기(@ConditionalOnProperty)는 **이 빌드 때** 굳는다 — 이미지를 만들 때의 환경변수(빌드 환경)가 곧 구성이다. 실행 때 환경변수로는 값(DB 주소 · 비밀)만 바꾼다.
# 런타임 스테이지는 glibc 리눅스여야 한다(빌더가 glibc 로 링크한다) — alpine(musl)이 아니다. wget 은 헬스체크용으로 따로 넣는다.
# runtime-base 단계는 실행 파일을 넣기 전의 실행 이미지다 — scripts/native-test.sh --ffmpeg 가 만든 실행 파일을 여기에 붙여 시험한다
# (이 레포의 시험 범위: 빌더 스테이지 = scripts/native-build.sh 와 같은 명령, 실행 = scripts/native-test.sh · runtime-base 단계(`FFMPEG=1` 포함)에서 실행 파일을 돌려 확인했다.
# 아래 마지막 단계까지 한 번에 `docker build` 로 끝까지 돌려 보지는 않았다.)

FROM debian:bookworm-slim AS runtime-base
ARG FFMPEG=0
RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates $( [ "$FFMPEG" = 1 ] && echo ffmpeg ) && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app && useradd --system --gid app app
WORKDIR /app
USER app

FROM ghcr.io/graalvm/native-image-community:25 AS builder
ARG APP=api
WORKDIR /app
COPY . .
RUN if [ "$APP" = workbench ]; then echo "apps/workbench is a demo of every module and is not deployable (docs/deploy.md)" >&2; exit 1; fi
RUN ./gradlew :apps:${APP}:nativeCompile -Pnative -PjavaToolchain=25 -x test --no-daemon

FROM runtime-base
ARG APP=api
# 폴더째 복사한다: 이미지 처리(ImageIO · AWT)를 쓰는 앱은 실행 파일 곁에 libawt*.so · libjavajpeg.so 같은 공유 라이브러리가 함께 만들어지고, 없으면 기동이 실패한다
COPY --from=builder /app/apps/${APP}/build/native/nativeCompile/ /app/
EXPOSE 8080
ENTRYPOINT ["/app/app"]

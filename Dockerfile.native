# 네이티브 배포 이미지 (선택) — 기본 `Dockerfile`(JVM)은 그대로 두고, 이 파일은 GraalVM 네이티브 실행 파일을 담는다 (docs/native-image.md).
# 홈서버 배포 계약(docs/deploy.md)은 같다: 0.0.0.0:8080 · 로그는 stdout · 컨테이너 안에서 `wget` 이 돈다 · 환경변수 없이도 이미지는 같다.
#
#   docker build -f Dockerfile.native -t <image>:<tag> .                  # apps/api (스타터)
#   docker build -f Dockerfile.native --build-arg APP=sample -t ... .
#
# 주의: 모듈 켜기/끄기(@ConditionalOnProperty)는 **이 빌드 때** 굳는다 — 이미지를 만들 때의 환경변수(빌드 환경)가 곧 구성이다. 실행 때 환경변수로는 값(DB 주소 · 비밀)만 바꾼다.
# 런타임 스테이지는 glibc 리눅스여야 한다(빌더가 glibc 로 링크한다) — alpine(musl)이 아니다. wget 은 헬스체크용으로 따로 넣는다.
# (이 레포의 시험 범위: 빌더 스테이지 = scripts/native-build.sh 와 같은 명령, 실행 = scripts/native-test.sh. 아래 런타임 스테이지의 베이스 이미지 빌드는 이 환경에서 시험하지 않았다.)

FROM ghcr.io/graalvm/native-image-community:25 AS builder
ARG APP=api
WORKDIR /app
COPY . .
RUN if [ "$APP" = workbench ]; then echo "apps/workbench is a demo of every module and is not deployable (docs/deploy.md)" >&2; exit 1; fi
RUN ./gradlew :apps:${APP}:nativeCompile -Pnative -PjavaToolchain=25 -x test --no-daemon

FROM debian:bookworm-slim
ARG APP=api
RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app && useradd --system --gid app app
WORKDIR /app
USER app
COPY --from=builder /app/apps/${APP}/build/native/nativeCompile/app /app/app
EXPOSE 8080
ENTRYPOINT ["/app/app"]
